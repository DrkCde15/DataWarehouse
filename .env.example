# ============================================================
# Configuracoes do Pipeline API -> Data Warehouse
# ============================================================

# API
API_BASE_URL=https://api.exemplo.com/v1
API_KEY=sua_chave_aqui
API_RATE_LIMIT=10
API_PAGE_SIZE=100

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_warehouse
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECTION_STRING=postgresql+psycopg2://postgres:postgres@localhost:5432/data_warehouse

# Postgres (container)
POSTGRES_DB=data_warehouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Logging
LOG_LEVEL=INFO
